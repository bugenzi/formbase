# AI (required for field detection + chat)
ANTHROPIC_API_KEY=sk-ant-...

# Auth (optional — runs without auth when not set)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Database (required for document storage)
DATABASE_URL=postgresql://user:pass@localhost:5432/formbase

# File storage — Cloudflare R2 (S3-compatible)
R2_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=formbase-pdfs

# Server
PORT=3001
