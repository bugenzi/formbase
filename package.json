{
  "name": "formpdf-monorepo",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm --filter @formpdf/editor run build && pnpm --filter @formpdf/web run build",
    "build:editor": "pnpm --filter @formpdf/editor run build",
    "build:web": "pnpm --filter @formpdf/web run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
